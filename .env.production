# Production Environment Variables
# Copy this file to .env and fill in your actual values

# PostgreSQL
POSTGRES_PASSWORD=your-secure-postgres-password-here

# Backend API URL (for frontend)
VITE_API_URL=https://api.yourdomain.com

# App
APP_ENV=production
SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32

# Database
DATABASE_URL=postgresql+asyncpg://timelyna:your-secure-postgres-password-here@postgres:5432/timelyna

# Redis
REDIS_URL=redis://redis:6379/0

# JWT Keys (generate with: python backend/generate_keys.py)
AUTH_PRIVATE_KEY=your-private-key-here
AUTH_PUBLIC_KEY=your-public-key-here

ACCESS_TOKEN_EXPIRE_HOURS=8
REFRESH_TOKEN_EXPIRE_DAYS=30

# Rate limiting
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_WINDOW_MINUTES=10

# Email (configure with your SMTP provider)
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your-email@yourdomain.com
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=noreply@yourdomain.com
FRONTEND_URL=https://yourdomain.com

# License
LICENSE_PUBLIC_KEY=your-license-public-key-here
