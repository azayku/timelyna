# --------------------
# App
# --------------------
APP_ENV=development
SECRET_KEY=your-secret-key-here-min-32-chars

# --------------------
# CORS (comma-separated origins)
# --------------------
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173

# --------------------
# Database (Docker PostgreSQL)
# --------------------
DATABASE_URL=postgresql+asyncpg://timesheetpro:your-db-password@postgres:5432/timesheetpro?ssl=false

# --------------------
# Redis
# --------------------
REDIS_URL=redis://redis:6379/0

# --------------------
# JWT (RS256)
# --------------------
# Generate with: ssh-keygen -t rsa -b 4096 -m PEM -f jwt.key
# Then: openssl rsa -in jwt.key -pubout -outform PEM -out jwt.key.pub
AUTH_PRIVATE_KEY=
AUTH_PUBLIC_KEY=

ACCESS_TOKEN_EXPIRE_HOURS=8
REFRESH_TOKEN_EXPIRE_DAYS=30

# --------------------
# Admin account (first startup only)
# --------------------
ADMIN_PASSWORD=

# --------------------
# Rate limiting
# --------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_WINDOW_MINUTES=10

# --------------------
# Email
# --------------------
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@timesheetpro.com
FRONTEND_URL=http://localhost

# --------------------
# License
# --------------------
LICENSE_PUBLIC_KEY=
FINANCE_LICENSE_SECRET=your-finance-license-secret-here

# --------------------
# Supabase (optional)
# --------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --------------------
# pgAdmin (development only)
# --------------------
PGADMIN_PASSWORD=your-pgadmin-password-here
